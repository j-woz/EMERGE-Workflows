#!/bin/zsh
set -eu
setopt NULL_GLOB

THIS=${0:h:A}
source $THIS/../common/tools.zsh

zparseopts -D -E n=N
args DIR - ${*}

START=$SECONDS

if [[ ! -d $DIR ]] abort "No DIR=$DIR"

printf "JOB:    "
cat $DIR/jobid.txt | head -c 7
print

grep "NODES" $DIR/turbine.log | tail -1

# A run writes either one results.log or, with multiple output
# streams, several results-NNNNNN.log .  Pass whatever is there:
# NULL_GLOB so that no logs at all yields an empty list, which
# log-size reports on, rather than a literal unmatched pattern.
LOGS=( $DIR/results*.log )

$THIS/log-size $N 64 $LOGS

if (( ${#N} )) {
  print "AMReX finalized"
  find $DIR/runs -name agent.out             | \
    xargs --no-run-if-empty --max-args 4 cat | \
    grep -c "AMReX.*finalized"
}

if ! grep "Elapsed Time" $DIR/output.txt
then
  abort "No Elapsed Time!"
fi

STOP=$SECONDS
printf "REPORT TOOK: %0.1f\n" $[ STOP - START ]
